{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "railway-pantry",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "APP_ORIGIN": "https://railway-pantry.deepakkannika2.workers.dev"
  },
  "containers": [
    {
      "class_name": "RailwayPantryContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PANTRY", "class_name": "RailwayPantryContainer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RailwayPantryContainer"] }
  ]
}
