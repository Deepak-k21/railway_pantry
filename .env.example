PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
# Required in production; encrypts idempotency receipts containing bearer tokens.
# Keep this secret stable across restarts and back it up separately from the database.
REPLAY_SECRET=
DATA_DIR=.data/postgres
NODE_ENV=development
OTP_PROVIDER=console
# Local mode prints passenger OTPs in the backend terminal and never sends SMS.
# For real delivery set OTP_PROVIDER=twilio and fill these privately.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Set only when running behind the authenticated Cloudflare Worker proxy.
PROXY_SECRET=
